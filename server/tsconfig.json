{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "exclude": ["node_modules", "dist"]
}
